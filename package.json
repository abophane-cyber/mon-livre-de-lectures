{
  "name": "mon-livre-de-lectures",
  "version": "1.0.0",
  "description": "Transforme mes surlignements Kindle en fiches de lecture",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/*.test.js\"",
    "icons": "pwa-assets-generator --preset minimal-2023 public/icon.svg",
    "build:app": "vite build --mode native",
    "exe": "npm run build:app && electron-builder --win nsis",
    "apk": "npm run build:app && cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "app": "npm run build:app && electron ."
  },
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "idb": "^8.0.4",
    "pdfmake": "^0.3.15",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@vite-pwa/assets-generator": "^2.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "main": "electron/main.cjs",
  "author": "Mon livre de lectures",
  "build": {
    "appId": "fr.monlivre.lectures",
    "productName": "Mon livre de lectures",
    "directories": {
      "output": "installateurs"
    },
    "files": [
      "electron/**",
      "dist-native/**",
      "package.json",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/pwa-512x512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mon livre de lectures",
      "artifactName": "Mon livre de lectures - installation.${ext}"
    },
    "electronLanguages": [
      "fr",
      "en-US"
    ]
  }
}
